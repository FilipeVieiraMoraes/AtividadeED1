#include <stdio.h>

void decimalParaBinario(int decimal) {
    int bin[32], i = 0;
    while (decimal > 0) {
        bin[i++] = decimal % 2;
        decimal /= 2;
    }
    for (int j = i - 1; j >= 0; j--) {
        printf("%d", bin[j]);
    }
}

int main() {
    int d1 = 297, d2 = 4021, d3 = 9135;

    printf("a. Decimal: %d -> Binário: ", d1);
    decimalParaBinario(d1);
    printf(" -> Hexadecimal: %X\n", d1);

    printf("b. Decimal: %d -> Binário: ", d2);
    decimalParaBinario(d2);
    printf(" -> Hexadecimal: %X\n", d2);

    printf("c. Decimal: %d -> Binário: ", d3);
    decimalParaBinario(d3);
    printf(" -> Hexadecimal: %X\n", d3);

    return 0;
}
