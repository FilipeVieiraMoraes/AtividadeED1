#include <stdio.h>
#include <math.h>
#include <string.h>

int binarioParaDecimal,char bina; 
    int decimal = 0;
    int tamanho = strlen(bina);
    for (int i = 0; i <tamanho; i++){
        if (bina(i) == '1') {
            decimal += pow(2, tamanho - 1 - i);
        }
    return decimal;


int main() {
    char *b1 = "100101";
    char *b2 = "1000101101";
    char *b3 = "1111010110110";

    int d1 = binarioParaDecimal(b1);
    int d2 = binarioParaDecimal(b2);
    int d3 = binarioParaDecimal(b3);

    printf("a. Binário: %s -> Decimal: %d -> Hexadecimal: %c\n, %d\n", b1, d1, d1);
    printf("b. Binário: %s -> Decimal: %d -> Hexadecimal: %c\n, %d\n", b2, d2, d2);
    printf("c. Binário: %s -> Decimal: %d -> Hexadecimal: %c\n, %d\n", b3, d3, d3);

    return 0;
}
